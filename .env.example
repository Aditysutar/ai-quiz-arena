# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API (Server-Side Only)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended Gemini Models:
# - gemini-3.5-flash-lite (fastest, recommended default)
# - gemini-3.5-flash
# - gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: MongoDB Atlas Database Persistence
# Leave blank to use in-memory game state (MVP mode). The game works completely without MongoDB.
MONGODB_URI=
MONGODB_DB=ai_quiz_arena
